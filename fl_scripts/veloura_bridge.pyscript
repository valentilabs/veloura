# Veloura Bridge - Stage 1 proof of concept (FL Studio 2024 Piano Roll script)
#
# Run it from the Piano Roll: Tools > Scripts > veloura_bridge
#
# Each run handles at most ONE command that Veloura wrote to
# veloura_io/command.json, then writes a result file with a full readback of
# the notes in this Piano Roll. With no pending command it changes nothing.
#
# Commands:
#   add_notes     adds notes (never clears or replaces existing notes)
#   snapshot      read-only; records every note in this Piano Roll
#   remove_added  removes exactly the notes an earlier add_notes added, and
#                 only if they are still unambiguous; otherwise changes nothing
#   replace_added removes an earlier command's notes and adds new ones in the
#                 same run (one undo step); refuses if the old notes were edited
#   clear_and_add clears every note in this Piano Roll, then adds the new ones in
#                 the same run (Reapply: old and new never mash together)
#
# FL Studio sandbox: Piano Roll scripts may only write files inside the
# "Piano roll scripts" folder, and creating folders, deleting or renaming
# files is refused. So this script only creates new files in veloura_io/
# (which the Veloura app creates) and never deletes or renames anything.
# Every file is written body first, then a ".done" marker, so Veloura never
# reads a half-written file.
#
# Safety rules built in:
#   * the command file is data only; nothing in it is executed as code
#   * expired commands are refused
#   * a command ID is applied at most once, so retries never duplicate notes
#   * refuses to run while notes or a time range are selected, because the
#     script API may then only see the selection
#   * add_notes refuses a non-empty Piano Roll unless the command allows it
#
# To remove Veloura, delete this file and the veloura_io folder next to it.

import flpianoroll as flp
import json
import os
import re
import time

BRIDGE_DIR = os.environ.get("VELOURA_BRIDGE_DIR") or os.path.expanduser(
    "~/Documents/Image-Line/FL Studio/Settings/Piano roll scripts/veloura_io")
PROTOCOL = 2
BRIDGE_VERSION = "stage1-6"
MAX_NOTES = 256
COMMAND_TYPES = ("add_notes", "snapshot", "remove_added", "replace_added", "clear_and_add")
ID_PATTERN = re.compile(r"^[A-Za-z0-9-]{1,64}$")


def _path(name):
    return os.path.join(BRIDGE_DIR, name)


def _exists(name):
    return os.path.exists(_path(name))


def _write_text(name, text):
    f = open(_path(name), "w", encoding="utf-8")
    try:
        f.write(text)
    finally:
        f.close()


def _publish(name, obj):
    """Write <name>.json then <name>.done (holding the byte length) as the commit marker."""
    body = json.dumps(obj, indent=1)
    _write_text(name + ".json", body)
    _write_text(name + ".done", str(len(body.encode("utf-8"))))


def _read_published(name):
    """Read <name>.json only if its .done marker exists and the length matches."""
    if not (_exists(name + ".json") and _exists(name + ".done")):
        return None
    f = open(_path(name + ".done"), "r", encoding="utf-8")
    try:
        declared = int(f.read().strip())
    finally:
        f.close()
    f = open(_path(name + ".json"), "r", encoding="utf-8")
    try:
        raw = f.read()
    finally:
        f.close()
    if len(raw.encode("utf-8")) != declared:
        raise ValueError("%s.json is incomplete" % name)
    return json.loads(raw)


def _log(msg):
    try:
        flp.Utils.log("Veloura: " + msg)
    except Exception:
        pass


def _show(msg):
    try:
        flp.Utils.ShowMessage(msg)
    except Exception:
        pass


def _vel127(v):
    return int(round(v * 127))


def _note_dict(i, n):
    return {"index": i, "number": n.number, "time": n.time, "length": n.length,
            "velocity": round(n.velocity, 6), "vel127": _vel127(n.velocity),
            "pan": round(n.pan, 6), "release": round(n.release, 6), "color": n.color,
            "slide": bool(n.slide), "porta": bool(n.porta), "muted": bool(n.muted),
            "selected": bool(n.selected)}


def _snapshot():
    score = flp.score
    return [_note_dict(i, score.getNote(i)) for i in range(score.noteCount)]


def _context():
    """Best effort: which channel/pattern is this? Uses MIDI-scripting modules if FL allows it here."""
    ctx = {}
    try:
        import channels
        idx = channels.selectedChannel()
        ctx["channel_index"] = idx
        ctx["channel_name"] = channels.getChannelName(idx)
    except Exception as e:
        ctx["channel_error"] = repr(e)[:200]
    try:
        import patterns
        num = patterns.patternNumber()
        ctx["pattern_number"] = num
        ctx["pattern_name"] = patterns.getPatternName(num)
    except Exception as e:
        ctx["pattern_error"] = repr(e)[:200]
    return ctx


def _key(d):
    return (d["number"], d["time"], d["length"], d["vel127"])


def _counts(keys):
    out = {}
    for k in keys:
        out[k] = out.get(k, 0) + 1
    return out


def _selection_problem(notes):
    if any(n["selected"] for n in notes):
        return "Some notes are selected. Deselect all notes (click an empty area of the Piano Roll) and run the script again."
    try:
        sel = flp.score.getTimelineSelection()
        if sel and len(sel) >= 2 and sel[1] != -1:
            return "A time range is selected on the timeline. Clear the selection and run the script again."
    except Exception:
        pass
    return None


def _num(x):
    return isinstance(x, (int, float)) and not isinstance(x, bool) and x == x and abs(x) != float("inf")


def _validate(cmd):
    errs = []
    if not isinstance(cmd, dict):
        return ["Command is not a JSON object."]
    if cmd.get("protocol") != PROTOCOL:
        errs.append("Unsupported protocol version (expected %d)." % PROTOCOL)
    if not isinstance(cmd.get("id"), str) or not ID_PATTERN.match(cmd["id"]):
        errs.append("Missing or invalid command id.")
    if cmd.get("type") not in COMMAND_TYPES:
        errs.append("Unknown command type.")
    if not _num(cmd.get("expires_at")):
        errs.append("Missing expiry time.")
    if cmd.get("type") in ("add_notes", "replace_added", "clear_and_add"):
        notes = cmd.get("notes")
        if not isinstance(notes, list) or not (1 <= len(notes) <= MAX_NOTES):
            errs.append("notes must be a list of 1-%d notes." % MAX_NOTES)
        else:
            for i, n in enumerate(notes, 1):
                if not isinstance(n, dict):
                    errs.append("note %d is not an object." % i)
                    continue
                p, s, l, v = n.get("pitch"), n.get("start_beats"), n.get("length_beats"), n.get("velocity")
                if not (isinstance(p, int) and not isinstance(p, bool) and 0 <= p <= 127):
                    errs.append("note %d: bad pitch." % i)
                if not (_num(s) and s >= 0):
                    errs.append("note %d: bad start." % i)
                if not (_num(l) and l > 0):
                    errs.append("note %d: bad length." % i)
                if not (isinstance(v, int) and not isinstance(v, bool) and 1 <= v <= 127):
                    errs.append("note %d: bad velocity." % i)
                if _num(s) and _num(l) and s + l > cmd.get("max_beats", 64) + 1e-9:
                    errs.append("note %d: ends past the pattern length." % i)
    if cmd.get("type") in ("remove_added", "replace_added"):
        if not isinstance(cmd.get("target_id"), str) or not ID_PATTERN.match(cmd["target_id"]):
            errs.append("%s needs a valid target_id." % cmd.get("type"))
    return errs


def _requested(cmd, result):
    """Convert the command's beat-based notes to ticks at FL's PPQ."""
    ppq = flp.score.PPQ
    requested = []
    warnings = []
    for n in cmd["notes"]:
        t_raw, l_raw = n["start_beats"] * ppq, n["length_beats"] * ppq
        t, l = int(round(t_raw)), int(round(l_raw))
        if abs(t_raw - t) > 1e-6 or abs(l_raw - l) > 1e-6:
            warnings.append("Note at beat %g was rounded to the nearest tick." % n["start_beats"])
        if l < 1:
            return None, "A note would be shorter than one tick at PPQ %d." % ppq
        requested.append({"number": n["pitch"], "time": t, "length": l, "vel127": n["velocity"]})
    result["requested_ticks"] = requested
    result["warnings"] = warnings
    return requested, None


def _add_requested(requested):
    for r in requested:
        note = flp.Note()
        note.number = r["number"]
        note.time = r["time"]
        note.length = r["length"]
        note.velocity = r["vel127"] / 127.0
        flp.score.addNote(note)


def _removal_check(target_id, current):
    """Which notes of an earlier command can be removed safely? Returns (target, indices, problem)."""
    target = _read_published("ledger-%s" % target_id)
    if not target or target.get("type") not in ("add_notes", "replace_added", "clear_and_add"):
        return None, None, "No applied Veloura command with that id is recorded."
    if _exists("removed-%s.marker" % target_id):
        return None, None, "Those notes were already removed or replaced."
    added = _counts([tuple(k) for k in target["added_keys"]])
    before_add = _counts([tuple(k) for k in target["before_keys"]])
    now = _counts([_key(d) for d in current])
    unsafe = [k for k, c in added.items() if now.get(k, 0) != before_add.get(k, 0) + c]
    if unsafe:
        return None, None, ("%d of Veloura's earlier notes were changed, moved or duplicated since they were written, so "
                            "Veloura cannot tell them apart safely. Nothing was changed; use FL Studio's Undo or edit by hand." % len(unsafe))
    indices = []
    remaining = dict(added)
    for d in reversed(current):
        k = _key(d)
        if remaining.get(k, 0) > 0:
            indices.append(d["index"])
            remaining[k] -= 1
    return target, indices, None


def _do_replace(cmd, result):
    current = _snapshot()
    result["before"] = current
    problem = _selection_problem(current)
    if problem:
        return "refused", problem
    if (flp.score.tsnum, flp.score.tsden) != (4, 4):
        return "refused", "Only 4/4 is supported."
    target, indices, problem = _removal_check(cmd["target_id"], current)
    if problem:
        return "refused", problem
    requested, problem = _requested(cmd, result)
    if problem:
        return "refused", problem
    _write_text("started-%s.marker" % cmd["id"], str(time.time()))
    _write_text("removed-%s.marker" % cmd["target_id"], cmd["id"])
    for idx in sorted(indices, reverse=True):
        flp.score.deleteNote(idx)
    _add_requested(requested)
    after = _snapshot()
    result["after"] = after
    old = _counts([tuple(k) for k in target["added_keys"]])
    others = _counts([_key(d) for d in current])
    for k, c in old.items():
        others[k] -= c
        if others[k] == 0:
            del others[k]
    expected = dict(others)
    for r in requested:
        k = _key(r)
        expected[k] = expected.get(k, 0) + 1
    ok = _counts([_key(d) for d in after]) == expected
    result["in_run_verification"] = {"passed": ok, "notes_before": len(current), "notes_removed": len(indices),
                                     "notes_added": len(requested), "notes_after": len(after)}
    other_keys = []
    for k, c in others.items():
        other_keys += [list(k)] * c
    _publish("ledger-%s" % cmd["id"], {
        "type": "replace_added", "status": "applied" if ok else "applied_unverified", "at": time.time(),
        "replaced": cmd["target_id"], "added_keys": [list(_key(r)) for r in requested], "before_keys": other_keys})
    if ok:
        return "applied", "Replaced %d earlier notes with %d new notes; your other notes untouched." % (len(indices), len(requested))
    return "applied_unverified", "Replacement readback did not match. Take a snapshot and check the Piano Roll."


def _do_add(cmd, result):
    score = flp.score
    before = _snapshot()
    result["before"] = before
    problem = _selection_problem(before)
    if problem:
        return "refused", problem
    if (score.tsnum, score.tsden) != (4, 4):
        return "refused", "The project time signature is %d/%d; Stage 1 supports only 4/4." % (score.tsnum, score.tsden)
    if before and not cmd.get("allow_existing_notes"):
        return "refused", ("This Piano Roll already has %d note(s). To protect your work Veloura only writes into an "
                           "empty Piano Roll unless told otherwise. Check you opened the test channel's Piano Roll." % len(before))

    requested, problem = _requested(cmd, result)
    if problem:
        return "refused", problem

    # Record the attempt BEFORE touching the Piano Roll. If this write fails we
    # stop with nothing changed; if FL crashes mid-way, the marker stops a
    # retry from adding the notes a second time.
    _write_text("started-%s.marker" % cmd["id"], str(time.time()))

    _add_requested(requested)

    after = _snapshot()
    result["after"] = after
    expected = _counts([_key(d) for d in before] + [_key(r) for r in requested])
    actual = _counts([_key(d) for d in after])
    ok = (expected == actual) and len(after) == len(before) + len(requested)
    result["in_run_verification"] = {
        "passed": ok,
        "notes_before": len(before), "notes_requested": len(requested), "notes_after": len(after)}
    _publish("ledger-%s" % cmd["id"], {
        "type": "add_notes", "status": "applied" if ok else "applied_unverified", "at": time.time(),
        "added_keys": [list(_key(r)) for r in requested],
        "before_keys": [list(_key(d)) for d in before]})
    if ok:
        return "applied", "Added %d notes; readback matched all %d." % (len(requested), len(requested))
    return "applied_unverified", "Notes were sent but the readback did not match. Do not rely on this result; take a snapshot."


def _do_clear_add(cmd, result):
    """Reapply: delete EVERY note in this Piano Roll (this channel, this pattern), then add the new notes, in one run,
    so old and new never mash together. One Cmd+Z in FL brings back what was there."""
    score = flp.score
    before = _snapshot()
    result["before"] = before
    if (score.tsnum, score.tsden) != (4, 4):
        return "refused", "The project time signature is %d/%d; Stage 1 supports only 4/4." % (score.tsnum, score.tsden)
    requested, problem = _requested(cmd, result)
    if problem:
        return "refused", problem
    _write_text("started-%s.marker" % cmd["id"], str(time.time()))
    for idx in range(score.noteCount - 1, -1, -1):
        score.deleteNote(idx)
    _add_requested(requested)
    after = _snapshot()
    result["after"] = after
    ok = _counts([_key(d) for d in after]) == _counts([_key(r) for r in requested])
    result["in_run_verification"] = {"passed": ok, "notes_before": len(before), "notes_removed": len(before),
                                     "notes_added": len(requested), "notes_after": len(after)}
    _publish("ledger-%s" % cmd["id"], {
        "type": "clear_and_add", "status": "applied" if ok else "applied_unverified", "at": time.time(),
        "added_keys": [list(_key(r)) for r in requested], "before_keys": []})
    if ok:
        return "applied", "Cleared %d old notes and wrote %d new notes; readback matched." % (len(before), len(requested))
    return "applied_unverified", "Notes were sent but the readback did not match. Take a snapshot and check the Piano Roll."


def _do_remove(cmd, result):
    current = _snapshot()
    result["before"] = current
    problem = _selection_problem(current)
    if problem:
        return "refused", problem
    target, indices, problem = _removal_check(cmd["target_id"], current)
    if problem:
        return "refused", problem
    _write_text("started-%s.marker" % cmd["id"], str(time.time()))
    _write_text("removed-%s.marker" % cmd["target_id"], cmd["id"])
    for idx in sorted(indices, reverse=True):
        flp.score.deleteNote(idx)
    after = _snapshot()
    result["after"] = after
    expected = _counts([_key(d) for d in current])
    for k, c in _counts([tuple(k) for k in target["added_keys"]]).items():
        expected[k] -= c
        if expected[k] == 0:
            del expected[k]
    ok = _counts([_key(d) for d in after]) == expected
    result["in_run_verification"] = {"passed": ok, "notes_before": len(current), "notes_removed": len(indices), "notes_after": len(after)}
    if ok:
        return "applied", "Removed the %d notes written by %s; all other notes untouched." % (len(indices), cmd["target_id"])
    return "applied_unverified", "Removal readback did not match. Take a snapshot and check the Piano Roll."


def _main():
    if not os.path.isdir(BRIDGE_DIR):
        _show("Veloura: bridge folder not found:\n%s\nNothing was changed." % BRIDGE_DIR)
        return
    try:
        cmd = _read_published("command")
        bad_json = None
    except Exception as e:
        cmd, bad_json = None, repr(e)
        if not isinstance(e, ValueError):
            raise
    if cmd is None and bad_json is None:
        # Silent on purpose (a pop-up would block the next keystroke trigger). Leave an "awake" marker so
        # Veloura knows this script is now FL's "last script" and the shortcut will reach it.
        try:
            _write_text("armed-%d.marker" % int(time.time() * 1000), str(time.time()))
        except Exception:
            pass
        _log("no pending command; nothing was changed.")
        return

    result = {"protocol": PROTOCOL, "bridge_version": BRIDGE_VERSION, "handled_at": time.time()}
    errs = ["Command file could not be read: %s" % bad_json] if bad_json else _validate(cmd)
    cmd_id = cmd.get("id") if isinstance(cmd, dict) and isinstance(cmd.get("id"), str) and ID_PATTERN.match(cmd.get("id", "")) else None
    result["id"] = cmd_id
    result["type"] = cmd.get("type") if isinstance(cmd, dict) else None
    show = bool(cmd.get("show_message", True)) if isinstance(cmd, dict) else True
    stamp = int(time.time() * 1000)

    already = cmd_id and (_exists("result-%s.done" % cmd_id) or _exists("started-%s.marker" % cmd_id))
    try:
        score = flp.score
        result["ppq"], result["tsnum"], result["tsden"] = score.PPQ, score.tsnum, score.tsden
        result["context"] = _context()
        if errs:
            status, message = "rejected", "Invalid command: " + " ".join(errs)
        elif already:
            status = "duplicate_ignored"
            message = "Command %s was already handled. Nothing was changed." % cmd_id
        elif time.time() > cmd["expires_at"]:
            status, message = "expired", "Command expired before it was run. Nothing was changed. Prepare a new one."
        elif cmd["type"] == "snapshot":
            notes = _snapshot()
            result["notes"] = notes
            status, message = "snapshot", "Read %d notes. Nothing was changed." % len(notes)
        elif cmd["type"] == "add_notes":
            status, message = _do_add(cmd, result)
        elif cmd["type"] == "replace_added":
            status, message = _do_replace(cmd, result)
        elif cmd["type"] == "clear_and_add":
            status, message = _do_clear_add(cmd, result)
        else:
            status, message = _do_remove(cmd, result)
    except Exception as e:
        status, message = "error", "Unexpected error: %r" % (e,)
        if cmd_id and _exists("started-%s.marker" % cmd_id) and not already:
            message += " The operation may be partly applied. Take a snapshot before doing anything else."
    result["status"], result["message"] = status, message

    if not cmd_id:
        name = "result-invalid-%d" % stamp
    elif already:
        name = "result-%s-dup-%d" % (cmd_id, stamp)
    else:
        name = "result-%s" % cmd_id
    try:
        _publish(name, result)
    except Exception as e:
        message += " (Could not write the result file: %r)" % (e,)
    _log(message)
    if show:
        _show("Veloura [%s]: %s" % (status, message))


try:
    _main()
except Exception as _e:
    _show("Veloura bridge hit an unexpected error: %r\nLook at the Piano Roll (or run a snapshot) before doing anything else." % (_e,))
